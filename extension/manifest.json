{
  "manifest_version": 3,
  "name": "Student Tracker",
  "version": "1.0",
  "description": "Предназначено для студентов и их преподавателй с целью улучшения дистанционного обучения",
  "permissions": ["history", "tabs", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "16.png",
      "48": "48.png",
      "128": "128.png"
    }
  }
}
