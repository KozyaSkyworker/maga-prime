{
  "manifest_version": 3,
  "name": "Tracker",
  "version": "1.0",
  "description": "",
  "permissions": ["history", "tabs", "scripting", "activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "16.png",
      "48": "48.png",
      "128": "128.png"
    }
  }
}
